# Firebase web app (client-side, public config)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=crush-o-meter-3b5db.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=crush-o-meter-3b5db
VITE_FIREBASE_STORAGE_BUCKET=crush-o-meter-3b5db.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=

# Server
PORT=5000
APP_URL=http://localhost:5000
JWT_SECRET=replace-with-a-long-random-string

# OpenRouter (server-side only)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Serper.dev (server-side only)
SERPER_API_KEY=

# Optional
DB_PATH=server/data/crush-o-meter.db
